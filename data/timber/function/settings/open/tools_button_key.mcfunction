# the button of an axe that was found by itself (timber:axes/auto): the name of the item, the item id when it has no translation
$execute if score $(holder) timber matches 1 run data modify storage timber:settings dialog.actions append value {"label":{"translate":"options.generic_value","with":[["Enable ",{"translate":"$(key)","fallback":"$(label)"}],{"translate":"options.on","color":"green"}]},"width":150,"action":{"type":"minecraft:run_command","command":"trigger TimberSettings set $(code)"}}
$execute unless score $(holder) timber matches 1 run data modify storage timber:settings dialog.actions append value {"label":{"translate":"options.generic_value","with":[["Enable ",{"translate":"$(key)","fallback":"$(label)"}],{"translate":"options.off","color":"red"}]},"width":150,"action":{"type":"minecraft:run_command","command":"trigger TimberSettings set $(code)"}}
