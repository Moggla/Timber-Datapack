# builds the settings dialog with the current values and shows it to the player
data modify storage timber:settings dialog set value {"type":"minecraft:notice","title":"Timber Global Settings","external_title":"Timber Settings","inputs":[{"type":"minecraft:boolean","key":"standing","label":["",{"text":"Works When Standing"}],"initial":true,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"sneaking","label":["",{"text":"Works When Sneaking"}],"initial":false,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"destroy_leaves","label":["",{"text":"Destroy Leaves"}],"initial":true,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"plant_sapling","label":["",{"text":"Auto Plant Saplings","hover_event":{"action":"show_text","value":["",{"text":"All kind of saplings laying on the ground will get planted every 2 seconds."},{"text":"\n\nWhen a sapling get placed on mud, it turns into muddy mangrove roots for a fraction of a second due to datapack limitations.","color":"gray"}]}}],"initial":false,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"destroy_roots","label":["",{"text":"Destroy Roots","hover_event":{"action":"show_text","value":["",{"text":"Only root blocks which are not in the ground count."}]}}],"initial":true,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"start_chop_on_root","label":["",{"text":"Chop Tree When Roots Get Destroyed","hover_event":{"action":"show_text","value":["",{"text":"The datapack will chop the tree if you break its root blocks.\nOnly root blocks which are not in the ground count."}]}}],"initial":true,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"slow_chop","label":["",{"text":"Chop Slowly","hover_event":{"action":"show_text","value":["",{"text":"The tree won't be chopped instantly anymore."},{"text":"\n\nThis option can increase performance.","color":"gray"}]}}],"initial":false,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"chop_down","label":["",{"text":"Enable Chopping Down","hover_event":{"action":"show_text","value":"Normally when you cut a tree in the middle only the top part of the tree gets destroyed. But if this option is enabled the bottom part will get destroyed as well."}}],"initial":false,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"stop_chopping","label":["",{"text":"Stop Chopping Once Axe Breaks","hover_event":{"action":"show_text","value":"Stops the process of chopping the tree as soon as your axe doesn't have any durability left for the whole tree. When disabled, the tree will always be chopped finish."}}],"initial":false,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"wear_out","label":["",{"text":"Additionally Wear out Tool Depending on Tree Size","hover_event":{"action":"show_text","value":"The tool's durability will get decreased by the amount of destroyed logs (or stems). When disabled, only one durability gets deducted."}}],"initial":true,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"drop_loot","label":["",{"text":"Drop Loot Straight into Inventory","hover_event":{"action":"show_text","value":["",{"text":"Lets the dropped items of the tree teleport straight into your own inventory. As soon as you have a full inventory the loot gets dropped on the ground."},{"text":"\n\nThis option can increase performance.","color":"gray"}]}}],"initial":false,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"hunger","label":["",{"text":"Give Additional Hunger Effect","hover_event":{"action":"show_text","value":"Gives a hunger effect for 1 second with the same level as the size of the chopped tree."}}],"initial":false,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"stopsound","label":["",{"text":"Stop Loud Breaking Noises","hover_event":{"action":"show_text","value":["",{"text":"Suppresses loud breaking noises when chopping a tree."},{"text":"\n\nThis option is","color":"gray"},{"text":" experimental","color":"dark_red"},{"text":" because sometimes it still sounds loud for a fraction of a second.","color":"gray"}]}}],"initial":false,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"wooden_axe","label":["",{"text":"Enable Wooden Axe"}],"initial":true,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"stone_axe","label":["",{"text":"Enable Stone Axe"}],"initial":true,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"copper_axe","label":["",{"text":"Enable Copper Axe"}],"initial":true,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"iron_axe","label":["",{"text":"Enable Iron Axe"}],"initial":true,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"golden_axe","label":["",{"text":"Enable Golden Axe"}],"initial":true,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"diamond_axe","label":["",{"text":"Enable Diamond Axe"}],"initial":true,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"netherite_axe","label":["",{"text":"Enable Netherite Axe"}],"initial":true,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"chop_trees","label":["",{"text":"Chop Trees","hover_event":{"action":"show_text","value":"All kind of trees will get chopped."}}],"initial":true,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"chop_fungi","label":["",{"text":"Chop Fungi","hover_event":{"action":"show_text","value":["",{"text":"Huge fungi (nether trees) as well as huge mushrooms will get chopped."},{"text":"\n\nUse it on your own risk!\nWhen enabled, this datapack can't differentiate between generated fungi and player-placed fungi and therefore can potentially destroy your buildings.","color":"dark_red"}]}}],"initial":false,"on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"persistent","label":["",{"text":"Destroy Player-Placed Trees","hover_event":{"action":"show_text","value":["",{"text":"Player-placed trees are trees made out of player-placed leaves (Look at leaf block with F3 debug screen: persistent = true)."},{"text":"\n\nUse it on your own risk!\nWhen enabled, this datapack can't differentiate between generated trees and player-placed trees anymore and therefore can potentially destroy your buildings.","color":"dark_red"}]}}],"initial":false,"on_true":"1","on_false":"0"},{"type":"minecraft:number_range","key":"blocks_per_chop","width":300,"label":["",{"text":"Set Amount of Destroyed Blocks per Chop","hover_event":{"action":"show_text","value":"Only used when \"Chop Slowly\" is enabled."}}],"start":1,"end":100,"step":1,"initial":1},{"type":"minecraft:number_range","key":"time_between_chops","width":300,"label":["",{"text":"Set Time in Ticks Between Chops","hover_event":{"action":"show_text","value":"Only used when \"Chop Slowly\" is enabled."}}],"start":1,"end":100,"step":1,"initial":1},{"type":"minecraft:number_range","key":"max_tree_size","width":300,"label":["",{"text":"Set Max. Tree Size","hover_event":{"action":"show_text","value":["",{"text":"Default: 555"},{"text":"\n\nTrees bigger than this set value won't get further processed."}]}}],"start":0,"end":1000,"step":1,"initial":0},{"type":"minecraft:number_range","key":"min_leaves_found","width":300,"label":["",{"text":"Set Min. Leaves to Valid a Tree","hover_event":{"action":"show_text","value":["",{"text":"Default: 5"},{"text":"\n\nThis datapack considers a tree only if it has this set value amount of naturally generated leaves at its trunk.\nFungi will get checked by the amount of cap blocks and additionally a 3×3 big cross on top of the stem."}]}}],"start":0,"end":10,"step":1,"initial":0}],"can_close_with_escape":true,"pause":true,"after_action":"close","action":{"label":{"translate":"gui.done"},"action":{"type":"minecraft:dynamic/run_command","template":"function timber:settings/set {\"standing\":$(standing),\"sneaking\":$(sneaking),\"destroy_leaves\":$(destroy_leaves),\"plant_sapling\":$(plant_sapling),\"destroy_roots\":$(destroy_roots),\"start_chop_on_root\":$(start_chop_on_root),\"slow_chop\":$(slow_chop),\"chop_down\":$(chop_down),\"stop_chopping\":$(stop_chopping),\"wear_out\":$(wear_out),\"drop_loot\":$(drop_loot),\"hunger\":$(hunger),\"stopsound\":$(stopsound),\"wooden_axe\":$(wooden_axe),\"stone_axe\":$(stone_axe),\"copper_axe\":$(copper_axe),\"iron_axe\":$(iron_axe),\"golden_axe\":$(golden_axe),\"diamond_axe\":$(diamond_axe),\"netherite_axe\":$(netherite_axe),\"chop_trees\":$(chop_trees),\"chop_fungi\":$(chop_fungi),\"persistent\":$(persistent),\"blocks_per_chop\":$(blocks_per_chop),\"time_between_chops\":$(time_between_chops),\"max_tree_size\":$(max_tree_size),\"min_leaves_found\":$(min_leaves_found)}"}}}
