# run at every log of the tree: marks the leaves 2 blocks away from it (straight or around an edge), for trees with too few leaves right at the trunk
execute positioned ~ ~ ~2 if predicate timber:block/leaf unless entity @e[type=minecraft:marker,tag=timber_leaves_found,distance=...1,sort=nearest,limit=1] run summon marker ~ ~ ~ {Tags:["timber_leaves_found"]}
